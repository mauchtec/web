# Twilio voice (outbound calls). Never commit .env (it's in .gitignore).
# Use either (TWILIO_AUTH_TOKEN) OR (TWILIO_API_KEY_SID + TWILIO_API_KEY_SECRET).

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VOICE_FROM_NUMBER=+1XXXXXXXXXX

# Option A: Account Auth Token (Twilio Console → Account)
TWILIO_AUTH_TOKEN=

# Option B: API Key (Twilio Console → Account → API keys). SID starts with SK.
# TWILIO_API_KEY_SID=SK...
# TWILIO_API_KEY_SECRET=

# Required: public URL Twilio can reach for voice webhooks (e.g. https://xxxx.ngrok.io)
TWILIO_VOICE_WEBHOOK_BASE_URL=
# VoIP Configuration (pyVoIP / SIP)
# Used for direct SIP calling via monitored_call.py
VOIP_USERNAME=27878096471
VOIP_PASSWORD=AR8mP5XD4xt8
VOIP_SERVER=jhb1.vphone.co.za

# CompreFace configuration
COMPREFACE_BASE_URL=http://102.214.10.234:8000
COMPREFACE_API_KEY=your-compreface-service-api-key
COMPREFACE_DETECTION_API_KEY=your-compreface-detection-api-key
COMPREFACE_VERIFICATION_API_KEY=your-compreface-verification-api-key
COMPREFACE_RECOGNITION_FACES_PATH=/api/v1/recognition/faces/
COMPREFACE_TIMEOUT_SECONDS=30
PERSON_PHOTO_MIN_QUALITY_SCORE=81
PERSON_PHOTO_MATCH_THRESHOLD=81
PERSON_PHOTO_DEBUG_SAVE=0
PERSON_PHOTO_CROP_RATIO=0.72
PERSON_PHOTO_CROP_TOP_BIAS=0.20
GATE_DEVICE_SYNC_TOKEN=change-me-to-a-long-random-secret
